# Copy to .env and fill in, then: docker compose up -d
#
# Create a Whoop app at https://developer-dashboard.whoop.com/apps/create
# with redirect URL http://localhost:8080/oauth/callback (or WHOOP_REDIRECT_URI).

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Bearer secret for /mcp and the setup page. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional. Defaults to http://localhost:8080/oauth/callback
# WHOOP_REDIRECT_URI=http://localhost:8080/oauth/callback

# Optional. Seeds the token store on first boot if you already ran whoop-auth.
# WHOOP_REFRESH_TOKEN=

# Serverless (Vercel) only. With these set, the rotating Whoop token is kept
# in Redis instead of on disk. The Vercel Upstash integration sets the
# KV_REST_API_* pair for you; a standalone Upstash database sets the
# UPSTASH_REDIS_REST_* pair. Either works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# WHOOP_TOKEN_KEY=whoop-mcp:token
